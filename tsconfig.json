{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx"
, "app/(admin)/components/Charts/ChartTwo.jsx", "app/(admin)/components/Charts/ChartThree.jsx", "app/(admin)/components/Charts/ChartOne.jsx", "app/(admin)/components/Charts/ChartFour.jsx", "app/(admin)/components/Chat/ChatCard.jsx", "app/(admin)/components/CardDataStats.jsx", "app/(admin)/components/Sidebar/index.jsx"  ],
  "exclude": [
    "node_modules"
  ]
}
